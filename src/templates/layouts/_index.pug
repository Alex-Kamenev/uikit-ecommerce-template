include ../data/_data
include ../mixins/_import

doctype html

//- Variables
block vars
  - var page

//- Template
html(lang="en")
  head
    include /partials/_head
    link(rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:400,500")
    link(rel="stylesheet" href="styles/style.css")
    script(src="scripts/uikit.js")
    script(src="scripts/uikit-icons.js")

  body
    div.uk-offcanvas-content
      block index

    script(src="scripts/script.js")
    if googleMapsApiKey
      script(src="https://maps.googleapis.com/maps/api/js?key=" + encodeURIComponent(googleMapsApiKey) + "&callback=initMap&loading=async"
             async)
